{
  "name": "jobpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal job-application copilot: autofill, tailored resumes, application memory.",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check": "npm run compile && npm test && npm run build && npm run check:manifest",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@react-pdf/renderer": "^4.8.1",
    "docx": "^9.7.1",
    "idb": "^8.0.3",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@wxt-dev/module-react": "^1.1.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.0",
    "typescript": "^5.8.3",
    "vitest": "4.1.11",
    "wxt": "^0.21.0"
  }
}
